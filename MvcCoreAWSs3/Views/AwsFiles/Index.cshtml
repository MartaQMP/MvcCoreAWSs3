@model List<string>
@{
    string bucketUrl = configuration.GetValue<string>("AWS:BucketUrl");
}

<h1>AWS Files S3</h1>
<hr />
<a asp-controller="AwsFiles" asp-action="UploadFile" class="btn btn-outline-dark">Cargar Fichero</a>
<br />
@if(Model != null)
{
    @foreach(string fileName in Model)
    {
        <div class="card" style="width: 18rem;">
            <img class="card-img-top" src="@bucketUrl@fileName" alt="Card image cap">
            <div class="card-body">
                <h5 class="card-title">@fileName</h5>
                <a asp-controller="AwsFiles" asp-action="DeleteFile" asp-route-fileName="@fileName" class="btn btn-danger">Eliminar</a>
                <a asp-controller="AwsFiles" asp-action="PrivateFile" asp-route-filename="@fileName" class="btn btn-secondary">Private</a>
            </div>
        </div>
    }
}
<br />
<p>@ViewBag.Mensaje</p>